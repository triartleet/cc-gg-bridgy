#!/bin/sh
# CC-GG-bridgy shim for claudeCode.claudeProcessWrapper.
# Contract (verified, ext 2.1.220): the Claude extension launches THIS
# executable with the real CLI as argv[1] — the bundled native-binary path,
# or [node, cli.js] when that fallback is in play — followed by the CLI
# flags. Fail OPEN: on any doubt, exec the real CLI untouched so Claude Code
# keeps working.

set -u

CONFIG_DIR="${HOME}/.config/cc-gg-bridgy"
STATE_FILE="${CONFIG_DIR}/state.json"
DEBUG_LOG="${CONFIG_DIR}/debug.log"
# The extension's spawn env is not injectable from outside, so a flag FILE
# also enables debug; an explicit env value (even 0) still wins.
if [ -z "${CC_GG_BRIDGY_DEBUG:-}" ] && [ -f "${CONFIG_DIR}/debug-on" ]; then
  CC_GG_BRIDGY_DEBUG=1
fi
# Extension stores realpath'd project keys; compare against the physical cwd.
PWD_REAL="$(pwd -P)"

debug() {
  [ "${CC_GG_BRIDGY_DEBUG:-0}" = "1" ] || return 0
  mkdir -p "$CONFIG_DIR"
  if [ -f "$DEBUG_LOG" ] && [ "$(wc -c <"$DEBUG_LOG")" -gt 524288 ]; then
    : >"$DEBUG_LOG"
  fi
  printf '%s | cwd=%s | %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$PWD_REAL" "$*" >>"$DEBUG_LOG"
}

# Provider for this project from state.json. A provider is any name with an
# env profile at ${CONFIG_DIR}/<name>.env; "anthropic" is reserved for the
# clean-env passthrough. The quoted key is matched as a FIXED string (both
# quotes included, so one path can never prefix-match another) and the value
# is whatever quoted token follows its colon — pretty-printed and compact
# separators both parse. The value charset is restricted; a missing or
# malformed project value falls through to "default" (mirroring the
# extension's readState), and anything still unresolved fails closed to
# anthropic.
value_for_key() {
  line="$(grep -F "$1" "$STATE_FILE" | head -n 1)"
  [ -n "$line" ] || return 0
  rest="${line#*"$1"}"
  printf '%s\n' "$rest" | sed -n 's/^[[:space:]]*:[[:space:]]*"\([A-Za-z0-9_-]*\)".*/\1/p'
}

provider() {
  [ -f "$STATE_FILE" ] || { echo anthropic; return; }
  value="$(value_for_key "\"$PWD_REAL\"")"
  if [ -z "$value" ]; then
    value="$(value_for_key '"default"')"
  fi
  if [ -n "$value" ]; then
    echo "$value"
  else
    echo anthropic
  fi
}

# KEY=value lines only — parsed, never sourced, so a malformed value can't
# execute shell or half-apply the env.
load_env_file() {
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
    '' | \#*) continue ;;
    [A-Za-z_]*=*) export "${line?}" ;;
    *) debug "$1: skipped malformed line" ;;
    esac
  done <"$1"
}

# Real CLI when argv doesn't carry one: newest (by mtime) bundled binary from
# any installed Claude extension, else the system claude.
find_cli() {
  newest=""
  for d in "${HOME}/.cursor/extensions"/anthropic.claude-code-*/resources/native-binary/claude \
    "${HOME}/.vscode/extensions"/anthropic.claude-code-*/resources/native-binary/claude; do
    [ -x "$d" ] || continue
    if [ -z "$newest" ] || [ "$d" -nt "$newest" ]; then
      newest="$d"
    fi
  done
  if [ -n "$newest" ]; then
    echo "$newest"
  else
    command -v claude || true
  fi
}

PROVIDER="$(provider)"
debug "provider=$PROVIDER argv=$*"

if [ "$PROVIDER" != "anthropic" ]; then
  ENV_FILE="${CONFIG_DIR}/${PROVIDER}.env"
  # Back-compat override from the glm-only era.
  if [ "$PROVIDER" = "glm" ] && [ -n "${CC_GG_BRIDGY_GLM_ENV:-}" ]; then
    ENV_FILE="$CC_GG_BRIDGY_GLM_ENV"
  fi
  if [ -f "$ENV_FILE" ]; then
    load_env_file "$ENV_FILE"
    debug "provider env loaded from $ENV_FILE"
  else
    debug "no env profile at $ENV_FILE — running clean (anthropic)"
  fi
fi

if [ "$#" -ge 1 ]; then
  # Interpreter-style argv (bare "node" or a .js entry) — resolve, don't guess.
  case "$1" in
  node)
    NODE_BIN="$(command -v node || true)"
    if [ -n "$NODE_BIN" ]; then
      shift
      debug "exec node passthrough: $NODE_BIN"
      exec "$NODE_BIN" "$@"
    fi
    ;;
  *.js)
    NODE_BIN="$(command -v node || true)"
    if [ -n "$NODE_BIN" ]; then
      debug "exec node script passthrough: $NODE_BIN $1"
      exec "$NODE_BIN" "$@"
    fi
    ;;
  esac
  if [ -f "$1" ] && [ -x "$1" ]; then
    debug "exec passthrough: $1"
    exec "$@"
  fi
fi

CLI="$(find_cli)"
if [ -n "$CLI" ]; then
  debug "exec discovered CLI: $CLI"
  exec "$CLI" "$@"
fi

echo "cc-gg-wrapper: no Claude CLI found" >&2
exit 127
